{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@components/*": [
                "src/components/*"
            ],
            "@app/*": [
                "src/app/*"
            ],
            "@assets/*": [
                "src/assets/*"
            ],
            "@config/*": [
                "src/config/*"
            ],
            "@/*": [
                "src/*"
            ]
        }
    }
}